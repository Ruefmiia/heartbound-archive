---
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pagePath = base && pathname.startsWith(base) ? pathname.slice(base.length) || '/' : pathname;
const sitePath = (path: string) => `${base}${path}` || '/';

const links = [
	{ href: '/', label: '首页' },
	{ href: '/timeline', label: '时间线' },
	{ href: '/production', label: '制作' },
	{ href: '/promotion', label: '宣传' },
	{ href: '/episodes', label: '播出' },
	{ href: '/materials', label: '物料' },
	{ href: '/novel', label: '原著' },
];
---

<header class="site-header">
	<a class="brand" href={sitePath('/')} aria-label="Heartbound档案库首页">
		<span class="brand-mark" aria-hidden="true"></span>
		<span>HEARTBOUND ARCHIVE</span>
	</a>
	<nav aria-label="主要导航" class="main-nav">
		{links.map((link) => (
			<a
				href={sitePath(link.href)}
				class:list={{ active: pagePath === link.href }}
				aria-current={pagePath === link.href ? 'page' : undefined}
			>
				{link.label}
			</a>
		))}
	</nav>
</header>
