---
import type { ArchiveEvent } from '../data/events';
import EventRow from './EventRow.astro';
import Layout from '../layouts/Layout.astro';

interface Props {
	eyebrow: string;
	title: string;
	description: string;
	events: ArchiveEvent[];
	emptyTitle?: string;
	emptyDescription?: string;
	filters?: Array<{
		type: string;
		label: string;
	}>;
}

const {
	eyebrow,
	title,
	description,
	events,
	emptyTitle = '暂无档案',
	emptyDescription = '相关信息确认后会在这里补充。',
	filters = [],
} = Astro.props;
---

<Layout title={`${title}｜Heartbound档案库`} description={description}>
	<section class:list={['archive-intro', { 'archive-intro--filterable': filters.length > 0 }]} aria-labelledby="archive-title">
		<span>{eyebrow}</span>
		<h1 id="archive-title">{title}</h1>
		<p>{description}</p>
		{filters.length > 0 && (
			<div class="archive-filter-bar" data-event-filter-bar aria-label="按制作类型筛选">
				{filters.map((filter) => (
					<button
						class="archive-filter"
						type="button"
						data-event-filter
						data-filter-type={filter.type}
						aria-pressed="false"
					>
						<i aria-hidden="true"></i>
						{filter.label}
					</button>
				))}
			</div>
		)}
	</section>

	<section class="archive-content" aria-label={`${title}列表`} data-filter-results>
		{events.length > 0 ? (
			<div class="event-list">
				{events.map((event) => <EventRow event={event} />)}
			</div>
		) : (
			<div class="empty-state">
				<span>COMING SOON</span>
				<h2>{emptyTitle}</h2>
				<p>{emptyDescription}</p>
			</div>
		)}
	</section>
</Layout>

<script>
	const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-event-filter]');

	for (const button of filterButtons) {
		button.addEventListener('click', () => {
			const isActive = button.getAttribute('aria-pressed') === 'true';
			const nextActive = !isActive;
			const filterType = button.dataset.filterType;
			const results = button.closest('main')?.querySelector('[data-filter-results]');
			const filterBar = button.closest('[data-event-filter-bar]');

			for (const peer of filterBar?.querySelectorAll<HTMLButtonElement>('[data-event-filter]') ?? []) {
				peer.setAttribute('aria-pressed', 'false');
			}
			button.setAttribute('aria-pressed', String(nextActive));
			for (const row of results?.querySelectorAll<HTMLElement>('[data-event-type]') ?? []) {
				row.hidden = nextActive && row.dataset.eventType !== filterType;
			}
		});
	}
</script>
