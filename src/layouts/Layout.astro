---
import Header from '../components/Header.astro';
import QuickEntryButton from '../components/QuickEntryButton.astro';
import { events } from '../data/events';
import '@fontsource/barlow-condensed/latin-500.css';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Heartbound档案库',
	description = 'PerthSanta主演剧集《Heartbound》的制作、宣传与播出档案。',
} = Astro.props;

const latestDate = events[0]?.date.replaceAll('-', '/') ?? '—';
const assetBase = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${assetBase}favicon.svg`} />
		<link rel="icon" href={`${assetBase}favicon.ico`} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0a0a0a" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">跳至主要内容</a>
		<div class="site-shell">
			<Header />
			<main id="main-content">
				<slot />
			</main>
			<footer class="site-footer">
				<span>HEARTBOUND ARCHIVE</span>
				<a href="https://x.com/HeartboundTH" target="_blank" rel="noreferrer">
					X · @HeartboundTH <span aria-hidden="true">↗</span>
				</a>
				<span>{events.length} RECORDS · UPDATED {latestDate} · TIMEZONE UTC+8</span>
			</footer>
		</div>
		{import.meta.env.DEV && <QuickEntryButton />}
	</body>
</html>
